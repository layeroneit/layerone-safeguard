<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LayerOne.Safeguard.App</RootNamespace>
    <AssemblyName>Safeguard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Product>LayerOne App Safeguard</Product>
    <Company>Layer One IT Consultants LLC</Company>
    <Copyright>© Layer One IT Consultants LLC</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Safeguard.Brand\Safeguard.Brand.csproj" />
    <ProjectReference Include="..\Safeguard.Core\Safeguard.Core.csproj" />
    <ProjectReference Include="..\Safeguard.Alerts\Safeguard.Alerts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\logo\layer-one.png" Link="Assets\logo\layer-one.png" />
    <Resource Include="..\..\assets\icon\app.ico" Link="Assets\icon\app.ico" />
    <Resource Include="..\..\assets\icon\app-256.png" Link="Assets\icon\app-256.png" />
    <Resource Include="..\..\assets\tray\*.ico" Link="Assets\tray\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
