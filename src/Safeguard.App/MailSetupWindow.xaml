<Window x:Class="LayerOne.Safeguard.App.MailSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safeguard — Email alerts"
        Icon="pack://application:,,,/Assets/icon/app.ico"
        Width="580"
        Height="760"
        MinWidth="480"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4F8"
        FontFamily="Segoe UI"
        FontSize="16"
        TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="FinishButton"
                    Style="{StaticResource PrimaryButton}"
                    Height="48"
                    FontSize="18"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    Click="Finish_Click"
                    Content="Finish"/>
            <Button x:Name="LaterButton"
                    Margin="0,8,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#5C5670"
                    FontSize="14"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Click="Later_Click"
                    Content="Set up email later"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/Assets/icon/app-256.png"
                           Width="52" Height="52"
                           DockPanel.Dock="Left"
                           Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Email alerts" FontSize="26" FontWeight="Bold" Foreground="#1A1033"/>
                        <TextBlock Text="Where should Safeguard tell you when something needs a look?"
                                   Foreground="#5C5670" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="1. Your email address" FontWeight="SemiBold" Foreground="#1A1033"/>
                        <TextBlock Margin="0,4,0,8" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"
                                   Text="Alerts are sent from this mailbox to this mailbox. Safeguard does not use any other mail service."/>
                        <TextBox x:Name="AddressBox" Padding="8,6" TextChanged="Address_Changed"/>
                        <TextBlock x:Name="ProviderText" Margin="0,8,0,0" FontSize="14" Foreground="#3A2081" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FoundText" Margin="0,4,0,0" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="2. App password" FontWeight="SemiBold" Foreground="#1A1033"/>
                        <TextBlock x:Name="PasswordHelp" Margin="0,4,0,8" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"
                                   Text="Most email services need an app password here, not your normal password."/>
                        <PasswordBox x:Name="PasswordBox" Padding="8,6" PasswordChanged="Input_Changed"/>
                        <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#5C5670" TextWrapping="Wrap"
                                   Text="Stored locked to your Windows sign-in. Your child's account cannot read it."/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Also send to (optional)" FontWeight="SemiBold" Foreground="#1A1033"/>
                        <TextBlock Margin="0,4,0,8" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"
                                   Text="Another parent or guardian. Separate more than one with commas."/>
                        <TextBox x:Name="AlsoBox" Padding="8,6" TextChanged="Input_Changed"/>
                    </StackPanel>
                </Border>

                <Expander Header="More settings (only if your email is not Gmail, Outlook, Yahoo, or iCloud)"
                          FontSize="14" Foreground="#5C5670" Margin="0,0,0,14">
                    <Border Background="White" CornerRadius="10" Padding="18" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Outgoing mail server" FontSize="14" Foreground="#1A1033"/>
                            <TextBox x:Name="HostBox" Padding="8,6" Margin="0,4,0,10" TextChanged="Input_Changed"/>
                            <TextBlock Text="Port" FontSize="14" Foreground="#1A1033"/>
                            <TextBox x:Name="PortBox" Padding="8,6" Margin="0,4,0,0" Width="100" HorizontalAlignment="Left" Text="587" TextChanged="Input_Changed"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Background="White" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <TextBlock Text="3. Send a test email" FontWeight="SemiBold" Foreground="#1A1033"/>
                        <TextBlock Margin="0,4,0,10" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"
                                   Text="Safeguard sends one test. When it arrives, you are done."/>
                        <Button x:Name="TestButton"
                                Style="{StaticResource PrimaryButton}"
                                Height="40"
                                Width="200"
                                HorizontalAlignment="Left"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="Test_Click"
                                Content="Send test email"/>
                        <TextBlock x:Name="TestResult" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
