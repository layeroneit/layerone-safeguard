<Window x:Class="LayerOne.Safeguard.App.FlagLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safeguard — Flagged log"
        Icon="pack://application:,,,/Assets/icon/app.ico"
        Width="720"
        Height="680"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F6F4F8"
        FontFamily="Segoe UI"
        FontSize="15">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Flagged log" FontSize="24" FontWeight="Bold" Foreground="#1A1033"/>
            <TextBlock x:Name="IntroText" Margin="0,4,0,0" FontSize="14" Foreground="#5C5670" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="120" Height="40"
                    Content="Close" Click="Close_Click"/>
            <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                    Foreground="#B42318" FontSize="14" Cursor="Hand"
                    Content="Delete the whole log" Click="DeleteAll_Click"/>
        </DockPanel>
        <TextBox x:Name="LogText"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="12"
                 BorderThickness="0"
                 Background="White"
                 Foreground="#1A1033"/>
    </DockPanel>
</Window>
