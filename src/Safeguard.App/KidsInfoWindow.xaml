<Window x:Class="LayerOne.Safeguard.App.KidsInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What is Safeguard?"
        Icon="pack://application:,,,/Assets/icon/app.ico"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4F8"
        FontFamily="Segoe UI"
        FontSize="16">
    <StackPanel Margin="28">
        <DockPanel Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/icon/app-256.png" Width="52" Height="52"
                   DockPanel.Dock="Left" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Hi! This is Safeguard." FontSize="24" FontWeight="Bold" Foreground="#1A1033"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,10"
                   Text="Your parent turned on Safeguard to help keep you safe in Discord and Roblox."/>
        <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,10"
                   Text="It reads the chat on this screen while those apps are open. It does not block your games, and it does not save everyday chat."/>
        <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,10"
                   Text="If someone asks for your address, asks you to keep secrets from your parents, asks for pictures, or wants to meet up, Safeguard lets your parent know so you can talk about it together."/>
        <Border Background="White" CornerRadius="10" Padding="14" Margin="0,6,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#3A2081" FontWeight="SemiBold"
                       Text="If anything online feels weird or scary, you can always tell a grown-up you trust. You will not be in trouble for telling."/>
        </Border>
        <Button Style="{StaticResource PrimaryButton}" Height="44" FontWeight="SemiBold"
                Content="Got it" Click="Close_Click"/>
    </StackPanel>
</Window>
