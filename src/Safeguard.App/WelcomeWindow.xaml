<Window x:Class="LayerOne.Safeguard.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Safeguard"
        Icon="pack://application:,,,/Assets/icon/app.ico"
        Width="560"
        Height="620"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F6F4F8"
        FontFamily="Segoe UI"
        FontSize="16"
        TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="28">
        <Button x:Name="StartButton"
                Style="{StaticResource PrimaryButton}"
                DockPanel.Dock="Bottom"
                Content="Start Safeguard"
                Height="48"
                FontSize="18"
                FontWeight="SemiBold"
                Background="#3A2081"
                Foreground="White"
                BorderThickness="0"
                IsEnabled="False"
                Click="Start_Click"/>
        <ScrollViewer>
            <StackPanel>
                <DockPanel Margin="0,0,0,20">
                    <Image Source="pack://application:,,,/Assets/icon/app-256.png"
                           Width="60"
                           Height="60"
                           DockPanel.Dock="Left"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Safeguard" FontSize="28" FontWeight="Bold" Foreground="#1A1033"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="from" Foreground="#5C5670" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Image Source="pack://application:,,,/Assets/logo/layer-one.png"
                                   Height="14"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTip="Layer One IT Consultants LLC"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,12"
                           Text="This is a parent helper for this Windows computer. It is made for families, not for IT staff."/>
                <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,12"
                           Text="Safeguard stays in the lower-right corner of the screen (the tray). It does not hide. Your child can see it is on."/>
                <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,12"
                           Text="It only watches Discord and Roblox, and only while those apps are open. When they are closed, Safeguard rests and does almost no work. It does not change, block, or slow those apps on purpose."/>
                <TextBlock TextWrapping="Wrap" Foreground="#1A1033" Margin="0,0,0,12"
                           Text="It will start when you sign in to Windows, so it is ready before Discord or Roblox open."/>
                <TextBlock TextWrapping="Wrap" Foreground="#5C5670" FontSize="14" Margin="0,8,0,16"
                           Text="Provided AS-IS, with no warranty. Layer One IT Consultants LLC is not liable for how this software is used."/>
                <CheckBox x:Name="AcceptBox"
                          Foreground="#1A1033"
                          Checked="Accept_Changed"
                          Unchecked="Accept_Changed">
                    <TextBlock TextWrapping="Wrap"
                               Text="I understand this is provided as-is, with no warranty, and I will tell my child that Safeguard is running."/>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
